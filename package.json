{
  "name": "starter-react",
  "version": "0.0.0",
  "private": true,
  "description": "Starter React Web du Design System 4SH : composants headless, jetons de design, Storybook comme source de v\u00e9rit\u00e9.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "pnpm storybook",
    "storybook": "pnpm build-info && pnpm docs:config && pnpm docs:search && storybook dev -p 6006 --config-dir storybook",
    "build-storybook": "pnpm build-info && pnpm docs:config && pnpm docs:search && storybook build --config-dir storybook",
    "serve": "pnpm kit:build && pnpm --filter demo dev",
    "build": "pnpm kit:build && pnpm --filter demo build",
    "kit:build": "pnpm exports:build && pnpm --filter @4sh/ui-kit-react build",
    "kit:pack": "pnpm kit:build && pnpm --filter @4sh/ui-kit-react exec pnpm pack --pack-destination ../..",
    "tokens:build": "node scripts/tokens.build.mjs",
    "exports:build": "node scripts/exports.build.mjs",
    "build-info": "node scripts/build-info.mjs",
    "docs:config": "node scripts/docs.config.mjs && node scripts/component-vars.build.mjs",
    "docs:search": "node scripts/docs.search.mjs",
    "docs:config:check": "node scripts/docs.config.mjs --check && node scripts/component-vars.build.mjs --check && pnpm components:check && pnpm exports:check && pnpm deps:check && pnpm links:check && pnpm prose:check",
    "components:check": "node scripts/components.check.mjs",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc -p packages/ui-kit-react/tsconfig.json && tsc -p apps/demo/tsconfig.json && tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "postinstall": "pnpm tokens:build && pnpm exports:build",
    "exports:check": "node scripts/exports.build.mjs --check",
    "deps:check": "node scripts/deps.check.mjs",
    "links:check": "node scripts/docs.links.check.mjs",
    "prose:check": "node scripts/prose.check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@storybook-community/storybook-dark-mode": "7.1.4",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-designs": "11.1.4",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "minisearch": "7.2.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "sass": "1.104.0",
    "storybook": "10.6.0",
    "style-dictionary": "5.5.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.2.2",
    "vitest": "5.0.1",
    "vitest-browser-react": "2.3.0"
  }
}
